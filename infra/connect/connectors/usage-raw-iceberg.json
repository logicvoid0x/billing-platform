{
  "connector.class": "org.apache.iceberg.connect.IcebergSinkConnector",
  "tasks.max": "2",
  "topics": "usage.raw",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "com.logicvoid0x.billing.usageconnect.UsageRawConverter",
  "errors.tolerance": "none",

  "iceberg.tables": "billing.usage_raw",
  "iceberg.tables.auto-create-enabled": "true",
  "iceberg.tables.default-partition-by": "hour(event_time)",
  "iceberg.tables.evolve-schema-enabled": "false",
  "iceberg.control.topic": "usage.archive.control",
  "iceberg.control.commit.interval-ms": "10000",

  "iceberg.catalog.type": "rest",
  "iceberg.catalog.uri": "http://iceberg-rest:8181",
  "iceberg.catalog.io-impl": "org.apache.iceberg.aws.s3.S3FileIO",
  "iceberg.catalog.warehouse": "s3://archive/warehouse",
  "iceberg.catalog.s3.endpoint": "http://seaweedfs:8333",
  "iceberg.catalog.s3.path-style-access": "true",
  "iceberg.catalog.s3.access-key-id": "billing",
  "iceberg.catalog.s3.secret-access-key": "billing-local-secret",
  "iceberg.catalog.client.region": "us-east-1"
}
